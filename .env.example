# ==============================================================================
# PARQUE SAFARI - ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# Estándar de Seguridad: "Cero Credenciales en Código" (Políticas OWASP ASVS / ISO 27001)
# Instrucciones: Copiar este archivo como '.env' en la raíz y configurar los valores.
# ==============================================================================

# Clave Secreta Criptográfica de Django (Obligatoria cuando DEBUG=False)
# Generar una clave segura única: py -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REEMPLAZAR_POR_CLAVE_ALEATORIA_SEGURA_50_CHARS

# Clave dedicada para cifrado simétrico Fernet de datos sensibles (opcional, deriva de SECRET_KEY si se omite)
SAFARI_PII_KEY=REEMPLAZAR_POR_CLAVE_PII_OPCIONAL

# Modo de Depuración (True para desarrollo local, False obligatorio para producción)
DEBUG=True

# Acceso Demo Académico en portal de login (True solo para evaluación docente en sandbox)
SAFARI_DEMO_MODE=True

# Tiempo máximo de inactividad de sesión en el servidor (en segundos; 900 = 15 minutos)
SESSION_INACTIVITY_TIMEOUT=900

# Hosts autorizados separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Cerrado y Orígenes Confiables CSRF (separados por coma, nunca '*')
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Redirección forzada HTTPS y cabecera de proxy reverso en producción
SECURE_SSL_REDIRECT=False
SAFARI_TRUST_PROXY=False
SECURE_HSTS_SECONDS=31536000

# Correo saliente en producción (cuando DEBUG=False)
EMAIL_HOST=smtp.ejemplo.cl
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@parquesafari.cl

# ------------------------------------------------------------------------------
# MOTOR DE BASE DE DATOS (Opciones: postgresql | mysql | sqlite)
# ------------------------------------------------------------------------------
# Para producción según Informe Técnico: 'postgresql'
# Para despliegues alternativos según Rúbrica: 'mysql'
# Para desarrollo local ligero: 'sqlite'
DB_ENGINE=sqlite

# Parámetros de Conexión a Base de Datos (PostgreSQL / MySQL)
DB_NAME=parque_safari_db
DB_USER=safari_admin
DB_PASSWORD=REEMPLAZAR_PASSWORD_SEGURA_BD
DB_HOST=localhost
DB_PORT=5432
# (Nota: Para PostgreSQL el puerto por defecto es 5432; para MySQL es 3306)
