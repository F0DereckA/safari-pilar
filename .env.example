# ==============================================================================
# PARQUE SAFARI - ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# Estándar de Seguridad: "Cero Credenciales en Código" (Políticas OWASP ASVS / ISO 27001)
# Instrucciones: Copiar este archivo como '.env' en la raíz y configurar los valores.
# ==============================================================================

# Clave Secreta Criptográfica de Django (Obligatoria para producción)
# Generar una clave segura única: py -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-kbgkntm0$gq_w$q!^nsf@h#ch(9$g!p^8^rj3)h3_p4cb#y3a0

# Modo de Depuración (True para desarrollo local, False para producción)
DEBUG=True

# Hosts autorizados separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# MOTOR DE BASE DE DATOS (Opciones: postgresql | mysql | sqlite)
# ------------------------------------------------------------------------------
# Para producción según Informe Técnico: 'postgresql'
# Para despliegues alternativos según Rúbrica: 'mysql'
# Para desarrollo local ligero: 'sqlite'
DB_ENGINE=sqlite

# Parámetros de Conexión a Base de Datos (PostgreSQL / MySQL)
DB_NAME=parque_safari_db
DB_USER=safari_admin
DB_PASSWORD=safari_secure_password_2026
DB_HOST=localhost
DB_PORT=5432
# (Nota: Para PostgreSQL el puerto por defecto es 5432; para MySQL es 3306)
